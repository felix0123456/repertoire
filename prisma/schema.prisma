generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  votes     PieceVote[]
  logs      RehearsalLog[]
}

model Piece {
  id              String                  @id @default(cuid())
  title           String
  artist          String                  @default("")
  singers         String                  @default("") // Comma-separated singer names
  soloists        String                  @default("") // Comma-separated soloist names
  songType        String                  @default("") // Song-Typ / Genre / Stil
  difficulty      String                  @default("MEDIUM") // EASY | MEDIUM | HARD
  notes           String                  @default("")
  lastPracticedAt DateTime?
  createdBy       String                  @default("")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  votes           PieceVote[]
  sessionPieces   RehearsalSessionPiece[]
  logs            RehearsalLog[]
}

model PieceVote {
  id                  String   @id @default(cuid())
  userId              String
  pieceId             String
  likeScore           Int      @default(3) // 1..5 Beliebtheit
  confidenceScore     Int      @default(3) // 1..5 Sicherheit
  practiceNeededScore Int      @default(3) // 1..5 Übungsbedarf
  updatedAt           DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  piece Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@unique([userId, pieceId])
}

model RehearsalConfig {
  id                String   @id @default("default")
  planningMode      String   @default("SIMPLE_COUNT") // SIMPLE_COUNT | EXACT_DATES | MANUAL
  totalSessionsLeft Int      @default(4)
  piecesPerSession  Int      @default(6)
  updatedAt         DateTime @updatedAt
}

model ConcertEvent {
  id             String    @id @default(cuid())
  title          String
  scheduledDate  DateTime?
  location       String    @default("")
  additionalInfo String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model RehearsalSession {
  id             String                  @id @default(cuid())
  sessionNumber  Int
  title          String
  status         String                  @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  scheduledDate  DateTime?
  location       String                  @default("")
  additionalInfo String                  @default("")
  presentSingers String                  @default("") // Comma-separated present singers (empty = all)
  absentSoloists String                  @default("") // Comma-separated absent soloists
  isLocked       Boolean                 @default(false) // Prevents automatic overwrite of manual order/selection
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  pieces         RehearsalSessionPiece[]
  logs           RehearsalLog[]
}

model RehearsalSessionPiece {
  id               String           @id @default(cuid())
  sessionId        String
  pieceId          String
  sortOrder        Int              @default(0)
  isManualOverride Boolean          @default(false)
  createdAt        DateTime         @default(now())

  session RehearsalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  piece   Piece            @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pieceId])
}

model RehearsalLog {
  id                 String           @id @default(cuid())
  sessionId          String
  pieceId            String
  userId             String
  prevConfidence     Int
  newConfidence      Int
  prevPracticeNeeded Int
  newPracticeNeeded  Int
  comment            String           @default("")
  createdAt          DateTime         @default(now())

  session RehearsalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  piece   Piece            @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

