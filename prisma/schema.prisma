generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String             @unique
  instrument    String             @default("") // z.B. "Posaune", "Trompete", "Altsaxophon", "Tenorsaxophon", "Baritonsaxophon", "Klarinette / Holz", "Klavier / Keys", "Gitarre", "Bass", "Schlagzeug", "Gesang", "Dirigent / Leitung"
  createdAt     DateTime           @default(now())
  votes         PieceVote[]
  logs          RehearsalLog[]
  proposalVotes SongProposalVote[]
}

model Piece {
  id               String                  @id @default(cuid())
  title            String
  folderNumber     String                  @default("") // Nummer in der Mappe
  artist           String                  @default("")
  singers          String                  @default("") // Comma-separated singer names
  soloists         String                  @default("") // Comma-separated soloist names
  songType         String                  @default("") // Song-Typ / Genre / Stil
  difficulty       String                  @default("MEDIUM") // EASY | MEDIUM | HARD
  bpm              Int                     @default(0) // Ziel-Tempo in BPM (0 = nicht hinterlegt)
  notes            String                  @default("")
  referenceUrl     String                  @default("") // YouTube/Spotify Referenz-Link des Arrangements
  focusInstruments String                  @default("") // Komma-separierte Instrumente mit besonderem Probebedarf (z.B. "Posaune, Saxophon")
  measureNotesJson String                  @default("[]") // JSON-Array: [{ id, measure, instrument, note, author, createdAt }]
  lastPracticedAt  DateTime?
  createdBy        String                  @default("")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  votes            PieceVote[]
  sessionPieces    RehearsalSessionPiece[]
  logs             RehearsalLog[]
}

model PieceVote {
  id                  String   @id @default(cuid())
  userId              String
  pieceId             String
  likeScore           Int      @default(3) // 1..5 Beliebtheit
  confidenceScore     Int      @default(3) // 1..5 Schwierigkeit
  practiceNeededScore Int      @default(3) // 1..5 Übungsbedarf
  updatedAt           DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  piece Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@unique([userId, pieceId])
}

model RehearsalConfig {
  id                String   @id @default("default")
  planningMode      String   @default("SIMPLE_COUNT") // SIMPLE_COUNT | EXACT_DATES | MANUAL
  totalSessionsLeft Int      @default(4)
  piecesPerSession  Int      @default(6)
  updatedAt         DateTime @updatedAt
}

model ConcertEvent {
  id               String    @id @default(cuid())
  title            String
  scheduledDate    DateTime?
  location         String    @default("")
  additionalInfo   String    @default("")
  setlistJson      String    @default("[]") // JSON-Array von Sets/Blöcken inkl. Stücken & Talk-Moderationen
  konzertmeisterId String    @default("")   // Konzertmeister-Termin-ID zur Dubletten-freien Synchronisation
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model RehearsalSession {
  id                   String                  @id @default(cuid())
  sessionNumber        Int
  title                String
  status               String                  @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  scheduledDate        DateTime?
  location             String                  @default("")
  additionalInfo       String                  @default("")
  presentSingers       String                  @default("") // Comma-separated present singers (empty = all)
  absentSoloists       String                  @default("") // Comma-separated absent soloists
  absentInstruments    String                  @default("") // Komma-separierte abwesende/unterbesetzte Register (z.B. "Saxophon, Posaune")
  isLocked             Boolean                 @default(false) // Prevents automatic overwrite of manual order/selection
  hasBreak             Boolean                 @default(false) // Optionale Pause in der Session
  breakDurationMinutes Int                     @default(15)    // Dauer der Pause in Minuten
  breakAfterPieceIndex Int                     @default(3)     // Position der Pause (nach dem N-ten Stück, 1-basiert)
  attendanceJson       String                  @default("[]")  // JSON-Array aus Konzertmeister: [{ userId, userName, instrument, status: "PRESENT"|"ABSENT"|"MAYBE", comment, updatedAt }]
  konzertmeisterId     String                  @default("")    // Konzertmeister-Termin-ID
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  pieces               RehearsalSessionPiece[]
  logs                 RehearsalLog[]
}

model RehearsalSessionPiece {
  id                String           @id @default(cuid())
  sessionId         String
  pieceId           String
  sortOrder         Int              @default(0)
  isManualOverride  Boolean          @default(false)
  estimatedMinutes  Int              @default(0)  // 0 = automatisch aus Übungsbedarf/Schwierigkeit (10-25 Min.), >0 = manuelle Überschreibung
  sessionBpm        Int              @default(0)  // Optionales Proben-Tempo in dieser Session (z.B. 160)
  sessionBpmComment String           @default("") // Optionaler Tempo-Kommentar für diese Session (z.B. "160 BPM, nächstes Mal schneller")
  createdAt         DateTime         @default(now())

  session RehearsalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  piece   Piece            @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pieceId])
}

model RehearsalLog {
  id                 String           @id @default(cuid())
  sessionId          String
  pieceId            String
  userId             String
  prevConfidence     Int
  newConfidence      Int
  prevPracticeNeeded Int
  newPracticeNeeded  Int
  comment            String           @default("")
  createdAt          DateTime         @default(now())

  session RehearsalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  piece   Piece            @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SongProposal {
  id                 String             @id @default(cuid())
  title              String
  artist             String             @default("")
  platform           String             @default("YOUTUBE") // YOUTUBE | SPOTIFY
  externalId         String             @default("")
  sourceUrl          String
  embedUrl           String             @default("")
  thumbnailUrl       String             @default("")
  previewAudioUrl    String             @default("")
  startSeconds       Int                @default(0)
  notes              String             @default("")
  proposedBy         String             @default("")
  transferredPieceId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  votes              SongProposalVote[]
}

model SongProposalVote {
  id         String       @id @default(cuid())
  proposalId String
  userId     String
  decision   String       @default("YES") // YES | NO | SUPER
  comment    String       @default("")
  updatedAt  DateTime     @updatedAt

  proposal SongProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, proposalId])
}
